        //         maxW = maxWeightPixels[i].weight;
        //         maxPos = maxWeightPixels[i].position;
        //     }
        // }

        if (weightSum > 0.0) {
            for (int i = 0; i < 4; i++) {
                ivec2 pos = maxWeightPixels[i].position;
                float normalizedWeight = maxWeightPixels[i].weight / weightSum;
                vec3 c = texelFetch(color, pos, 0).xyz;
                blendedColor += c * normalizedWeight;
            }
        }

        imageStore(warpColor, pixCoord, vec4(blendedColor,1.0));
    }
