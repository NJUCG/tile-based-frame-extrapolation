layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D color;
layout(binding = 1) uniform sampler2D mv;
layout(binding = 2) uniform sampler2D baseColor0;
layout(binding = 3) uniform sampler2D baseColor1;
layout(binding = 4) uniform sampler2D normal0;
layout(binding = 5) uniform sampler2D normal1;
layout(binding = 6) uniform sampler2D mask;

layout(rgba32f, binding = 0) writeonly uniform image2D  warpColor;

struct WeightedPixel {
    ivec2 position;
    float weight;
};

WeightedPixel maxWeightPixels[4];

void initializeMaxWeights() {
    for (int i = 0; i < 4; i++) {
        maxWeightPixels[i].position = ivec2(0, 0);
        maxWeightPixels[i].weight = 0.0;
    }
}

void updateMaxWeights(ivec2 pos, float weight) {
    int minIndex = 0;
    float minWeight = maxWeightPixels[0].weight;
    for (int i = 1; i < 4; i++) {
        if (maxWeightPixels[i].weight < minWeight) {
            minWeight = maxWeightPixels[i].weight;
            minIndex = i;
        }
    }

    if (weight > minWeight) {
        maxWeightPixels[minIndex].position = pos;
        maxWeightPixels[minIndex].weight = weight;
    }
}

const ivec2 offsets[] = {
    ivec2(-1, -1), ivec2(0, -1), ivec2(1, -1),
    ivec2(-1, 0), ivec2(1, 0),//ivec2(0,0),
    ivec2(-1, 1), ivec2(0, 1), ivec2(1, 1),
    ivec2(-2, -2), ivec2(0, -2), ivec2(2, -2),
    ivec2(-2, 0), ivec2(2, 0),
    ivec2(-2, 2), ivec2(0, 2), ivec2(2, 2),

    ivec2(-2, -1), ivec2(1, -2), ivec2(2, -1),
    ivec2(-1, -2), ivec2(-1, 2),
    ivec2(-2, 1), ivec2(1, 2), ivec2(2, 1),
};
const int s[]={1,3,5,7,9,11,13,15};
//const int s[]={1,3,5,7};

float featureDifference(vec3 g1, vec3 g2) {
    return length(g1 - g2);
}

void main(){

    ivec2 pixCoord = ivec2(gl_GlobalInvocationID.xy);
	ivec2 frameSize = textureSize(color, 0);
	if (pixCoord.x >= frameSize.x || pixCoord.y >= frameSize.y) {
		return;
	}
	vec2 size = vec2(frameSize);

    //find bar_x
    vec2 mv_curr = texelFetch(mv, pixCoord, 0).xy;
    ivec2 flow = ivec2(round(mv_curr));
    ivec2 bar_x = ivec2(pixCoord.x - flow.x, pixCoord.y - flow.y);
    vec3 mask_curr = texelFetch(mask,pixCoord,0).xyz;
    //if disoccluded or out-of-screen traverse N(x),calculate mu and sigma
    if (bar_x.x >= frameSize.x || bar_x.y >= frameSize.y || bar_x.x < 0 || bar_x.y < 0|| mask_curr.x == 1) {
