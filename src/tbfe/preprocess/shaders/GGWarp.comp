        //         vec3 neighborBaseColor = texelFetch(baseColor0, offset, 0).xyz;
        //         vec3 neighborNormal = texelFetch(baseColor1, offset, 0).xyz;

        //         float baseColorDiff = featureDifference(texelFetch(baseColor1, pixCoord, 0).xyz, neighborBaseColor);
        //         float normalDiff = featureDifference(texelFetch(normal1, pixCoord, 0).xyz, neighborNormal);

        //         float spatialDiff = length(bar_x - offset);

        //         sumSpatial += spatialDiff;
        //         sumSpatialSquared += spatialDiff * spatialDiff;

        //         sumBaseColor += baseColorDiff;
        //         sumBaseColorSquared += baseColorDiff * baseColorDiff;

        //         sumNormal += normalDiff;
        //         sumNormalSquared += normalDiff * normalDiff;

        //         count++;
        //     }
        // }

        // float muBaseColor = sumBaseColor / float(count);
        // float sigmaBaseColor = sqrt((sumBaseColorSquared / float(count)) - (muBaseColor * muBaseColor));

        // float muNormal = sumNormal / float(count);
        // float sigmaNormal = sqrt((sumNormalSquared / float(count)) - (muNormal * muNormal));

        // float muSpatial = sumSpatial / float(count);
        // float sigmaSpatial = sqrt((sumSpatialSquared / float(count)) - (muSpatial * muSpatial));

        float muBaseColor = 0;
        float sigmaBaseColor = 1;
        float muNormal = 0;
        float sigmaNormal = 1;
        float muSpatial = 0;
        float sigmaSpatial = 10;

        //traverse N(x) again,calculate weight and save 4 pixels with the largest blending weights
        initializeMaxWeights();
        for (int i = 0; i < 24; i++) {
            for(int j = 0; j < 8; j++){
                ivec2 offset = offsets[i] * s[j] + bar_x;
                // texelFetch has undefined behavior outside the texture. Skip
                // invalid neighbors while preserving weights for every valid
                // sample used by the original implementation.
                if (offset.x >= frameSize.x || offset.y >= frameSize.y ||
                    offset.x < 0 || offset.y < 0) {
                    continue;
                }

                vec3 neighborBaseColor = texelFetch(baseColor0, offset, 0).xyz;
                vec3 neighborNormal = texelFetch(normal0, offset, 0).xyz;


                float baseColorDiff = length(texelFetch(baseColor1, pixCoord, 0).xyz - neighborBaseColor );
                float normalDiff = length(texelFetch(normal1, pixCoord, 0).xyz - neighborNormal);
                float spatialDiff = length(offset - bar_x);


                float baseColorWeight = exp(-pow(baseColorDiff - muBaseColor, 2.0) / (2.0 * pow(sigmaBaseColor, 2.0)))*10;
                float normalWeight = exp(-pow(normalDiff - muNormal, 2.0) / (2.0 * pow(sigmaNormal, 2.0)));
                float totalWeight = baseColorWeight + normalWeight;
                //float spatialWeight = exp(-pow(spatialDiff - muSpatial, 2.0) / (2.0 * pow(sigmaSpatial, 2.0)));
                totalWeight = totalWeight * 1;


                updateMaxWeights(offset, totalWeight);
            }
        }

        //normalize weights, and blending
        float weightSum = 0.0;
        float maxW = 0.0;
        ivec2 maxPos = ivec2(0,0);
        vec3 blendedColor = vec3(0.0);
        for (int i = 0; i < 4; i++) {
            weightSum += maxWeightPixels[i].weight;
        }

        // for (int i = 0; i < 4; i++) {
